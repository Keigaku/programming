# ==============================================================================
# トクラボ (TokuLab) アフィリエイト収益エンジン 環境変数設定
# このファイルを `.env.local` にコピーし、ご自身のキーを設定してください。
# ==============================================================================

# --- サイト基本設定 ---
NEXT_PUBLIC_SITE_NAME="トクラボ"
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- 楽天ウェブサービス API (2026年新仕様: openapi.rakuten.co.jp) ---
# Rakuten Developers Dashboard (https://webservice.rakuten.co.jp/) で再登録して取得
# ※ サーバー/バッチ実行の場合は「バックエンド型（許可IP登録）」または
#    「Webアプリ型（許可ドメイン + Referer/Origin送信）」を選択してください
RAKUTEN_APP_ID=""
RAKUTEN_ACCESS_KEY=""
RAKUTEN_AFFILIATE_ID=""

# 2026年11月時点の最新APIバージョン（変更があった場合はここで上書き可能）
RAKUTEN_SEARCH_API_VERSION="20260701"
RAKUTEN_RANKING_API_VERSION="20220601"

# Webアプリケーション型で登録した場合に送信する Origin / Referer（任意）
RAKUTEN_APP_ORIGIN=""

# --- Amazonアソシエイト (API未解放フェーズ：トラッキングIDのみで即稼働) ---
# 例: yourstore-22
AMAZON_ASSOCIATE_TAG="yourtag-22"

# --- Amazon Creators API (直近30日10件販売達成後に解放・任意) ---
# 旧PA-API 5.0は2026年5月廃止。解放後にOAuth 2.0認証情報を設定
AMAZON_CREATORS_ENABLED="false"
AMAZON_CREATORS_CREDENTIAL_ID=""
AMAZON_CREATORS_CREDENTIAL_SECRET=""
AMAZON_CREATORS_REGION="fe"

# --- 運用スタジオ (/ops) 簡易保護トークン (本番デプロイ時は設定推奨) ---
OPS_ADMIN_SECRET=""

# --- X (Twitter) API v2 自動投稿用 (任意・手動コピー運用のみなら空欄でOK) ---
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
